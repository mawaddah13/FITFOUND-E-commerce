# Salin file ini menjadi ".env.local" lalu sesuaikan password PostgreSQL dan nama database Anda
DATABASE_URL=postgresql://postgres:password_user@localhost:5432/fitfound

# Kunci rahasia untuk menandatangani cookie sesi (bebas, minimal 32 karakter)
SESSION_SECRET=ganti_dengan_kunci_rahasia_minimal_32_karakter